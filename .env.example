# Fill actual values when available. Leave unset for local development.
NEXT_PUBLIC_SITE_URL=
ADSENSE_CLIENT=
GOOGLE_SITE_VERIFICATION=
# Publisher/contact fields live in src/content/site.config.json.
# No ad scripts load until adsenseEnabled AND consentConfigured are true.

# GA4 loads only on the production hostname after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Reach audience preferences: server-only secrets, configured in Vercel.
# Never use NEXT_PUBLIC_ for either secret.
REACH_PUBLISHER_ID=
REACH_PUBLISHER_SIGNING_KEY=
REACH_CONSENT_COOKIE_SECRET=
# Existing public ad-slot configuration (not credentials):
NEXT_PUBLIC_REACH_AD_SERVER=
NEXT_PUBLIC_REACH_PLACEMENT_ID=
